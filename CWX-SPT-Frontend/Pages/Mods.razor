@page "/Mods"

@inject ServerHelper ServerHelper

<MudContainer Class="px-8 my-2" MaxWidth="MaxWidth.Large">
    <MudContainer Class="d-flex justify-center pb-4">
        <MudText Typo="Typo.h5">Active Server Mods</MudText>
    </MudContainer>
    <MudGrid>
        @if (mods.Count > 0)
        {
            @foreach (var mod in mods)
            {
                <ModCardComponent Mod="@mod"/>
            }
        }
        else if (mods.Count == 0 && !IsConnected)
        {
            <MudItem sm="12">
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Please connect to a Server first!</MudAlert>
            </MudItem>
        }
        else if (mods.Count == 0)
        {
            <MudItem sm="12">
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No server mods loaded!</MudAlert>
            </MudItem>
        }
    </MudGrid>
</MudContainer>

@code {
    private bool IsConnected { get; set; }
    private List<SPTMod> mods { get; set; }

    protected override void OnInitialized()
    {
        IsConnected = ServerHelper.ConnectedServer is not null;
        mods = ServerHelper.ModList.Values.ToList();
        base.OnInitialized();
    }

}
