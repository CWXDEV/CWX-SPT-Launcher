@page "/Admin"
@inject LogHelper LogHelper

<MudContainer Class="px-8 my-2 pa-0" MaxWidth="MaxWidth.Large">
    <MudChat ChatPosition="ChatBubblePosition.Start">
        @foreach (var log in LogHelper.GetLogs())
        {
            <MudChatBubble>
                @log
            </MudChatBubble>
        }
    </MudChat>
</MudContainer>

@code
{
    protected override void OnInitialized()
    {
        LogHelper.OnLogsChanged += StateHasChanged;
        base.OnInitialized();
    }

    private void Dispose()
    {
        LogHelper.OnLogsChanged -= StateHasChanged;
    }
}
