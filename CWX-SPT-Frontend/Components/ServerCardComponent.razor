@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavMan
@inject ServerHelper ServerHelper
@inject SettingsHelper SettingsHelper
@inject NavigationHelper NavigationHelper

<MudItem md="4">
    <MudPaper Elevation="2" Class="pa-4 d-flex flex-column flex-none gap-2 card-overflow">
        <MudText Class="mb-n4 no-pointers no-select" Typo="Typo.caption">Name:</MudText>
        <MudText Typo="Typo.h6">@Server.Name</MudText>
        <MudDivider DividerType="DividerType.Middle"/>
        <MudText Class="mb-n3 no-pointers no-select" Typo="Typo.caption">Address:</MudText>
        <MudText Typo="Typo.body1">@Server.Ip</MudText>
        <MudDivider DividerType="DividerType.Middle"/>
        <MudText Class="mb-n3 no-pointers no-select" Typo="Typo.caption">Game Path:</MudText>
        <MudText Typo="Typo.body1">@Server.GamePath</MudText>
        <MudContainer Class="pa-0 d-flex mt-2">
            <MudTooltip Text="@(IsConnectedServer ? "Connected" : "Disconnected")" Arrow="true"
                        Placement="Placement.Bottom">
                <MudIcon Icon="@Icons.Material.Filled.Circle"
                         Color="@(IsConnectedServer ? Color.Success : Color.Error)"/>
            </MudTooltip>
            <MudSpacer/>
            <MudTooltip Text="@(!IsConnectedServer ? "Login to server" : "Logout of server")" Arrow="true" Placement="Placement.Bottom">
                <MudIconButton Class="mr-1 mb-n2" Color="Color.Default"
                               Icon="@(!IsConnectedServer ? Icons.Material.Filled.Login : Icons.Material.Filled.Logout)"
                               Size="Size.Small" @onclick="RunLoginTask"/>
            </MudTooltip>
            <MudTooltip Text="Edit server" Arrow="true" Placement="Placement.Bottom">
                <MudIconButton Color="Color.Default" Icon="@Icons.Material.Filled.Build" Size="Size.Small"
                               @onclick="RunEditTask"/>
            </MudTooltip>
            <MudTooltip Text="Delete server" Arrow="true" Placement="Placement.Bottom">
                <MudIconButton Color="Color.Error" Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                               @onclick="RunDeleteTask"/>
            </MudTooltip>
        </MudContainer>
    </MudPaper>
</MudItem>

@code {
    [Parameter] public Servers Server { get; set; }

    [Parameter] public List<Servers> ServerList { get; set; }

    [Parameter] public EventCallback<List<Servers>> ServerListChanged { get; set; }

    private bool IsConnectedServer { get; set; }

    protected override void OnInitialized()
    {
        IsConnectedServer = ServerHelper.ConnectedServer?.ServerId == Server.ServerId;
        base.OnInitialized();
    }

    private async Task RunEditTask()
    {
        if (ServerHelper.ConnectedServer?.ServerId == Server.ServerId)
        {
            ServerHelper.LogoutAndDispose();
            IsConnectedServer = false;
        }

        var param = new DialogParameters { { "Server", Server } };

        var dialog = await DialogService.ShowAsync<ServerEditDialog>("ServerEditDialog", param, SettingsHelper.DialogOptions);
        var result = await dialog.Result;

        if (result?.Canceled is false)
        {
            var serverToChange = ServerList.FirstOrDefault(x => x.ServerId == Server.ServerId);

            if (serverToChange != null)
            {
                serverToChange.Name = Server.Name;
                serverToChange.Ip = Server.Ip;
            }

            SettingsHelper.SetServerSettings(ServerList);
            await ServerListChanged.InvokeAsync(ServerList);
        }
    }

    private async Task RunLoginTask()
    {
        if (ServerHelper.ConnectedServer != null)
        {
            if (ServerHelper.ConnectedServer.ServerId == Server.ServerId)
            {
                ServerHelper.LogoutAndDispose();
                NavigationHelper.SetBasicPages(false);
                NavigationHelper.SetProfilePages(false);
                IsConnectedServer = false;
                return;
            }

            ServerHelper.LogoutAndDispose();
            NavigationHelper.SetBasicPages(false);
            NavigationHelper.SetProfilePages(false);
            IsConnectedServer = false;
        }

        var param = new DialogParameters { { "Server", Server } };

        var dialog = await DialogService.ShowAsync<ServerLoginDialog>("ServerLoginDialog", param, SettingsHelper.DialogOptions);
        var result = await dialog.Result;

        if (result?.Canceled is false)
        {
            ServerHelper.ServerLogin(Server);
            if (ServerHelper.ConnectedServer != null)
            {
                IsConnectedServer = ServerHelper.ConnectedServer.ServerId == Server.ServerId;
            }

            NavMan.NavigateTo("/Profiles");
        }
    }

    private async Task RunDeleteTask()
    {
        if (ServerHelper.ConnectedServer != null)
        {
            ServerHelper.LogoutAndDispose();
            IsConnectedServer = false;
        }

        var dialog = await DialogService.ShowAsync<ServerRemoveDialog>("ServerRemoveDialog", SettingsHelper.DialogOptions);
        var result = await dialog.Result;

        if (result?.Canceled is false)
        {
            ServerList.Remove(Server);
            await ServerListChanged.InvokeAsync(ServerList);

            SettingsHelper.SetServerSettings(ServerList);
        }
    }
}
