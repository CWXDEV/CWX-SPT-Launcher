@inject Navigation Navigation

<MudNavMenu>
    <MudNavLink IconColor="Color.Default" Icon="@Icons.Material.Filled.ConnectedTv" Href="/" Match="NavLinkMatch.All">Servers</MudNavLink>
    @if (Navigation.ShowProfilesPage)
    {
        <MudNavLink IconColor="Color.Default" Icon="@Icons.Material.Filled.PeopleAlt" Href="/Profiles" Match="NavLinkMatch.Prefix">Profiles</MudNavLink>
    }
    @if (Navigation.ShowProfilePage)
    {
        <MudNavLink IconColor="Color.Default" Icon="@Icons.Material.Filled.Person" Href="/Profile" Match="NavLinkMatch.Prefix">Profile</MudNavLink>
    }
    @if (Navigation.ShowModPage)
    {
        <MudNavLink IconColor="Color.Default" Icon="@Icons.Material.Filled.FolderOpen" Href="/Mods" Match="NavLinkMatch.Prefix">Mods</MudNavLink>
    }
</MudNavMenu>
<MudSpacer/>
<MudNavMenu>
    <MudNavLink IconColor="Color.Default" Icon="@Icons.Material.Filled.AdminPanelSettings" Href="/Admin" Match="NavLinkMatch.All">Admin</MudNavLink>
    <MudNavLink IconColor="Color.Default" Icon="@Icons.Material.Filled.Settings" Href="/Settings" Match="NavLinkMatch.Prefix">Settings</MudNavLink>
</MudNavMenu>

@code
{
    protected override void OnInitialized()
    {
        Navigation.OnStateChanged += StateHasChanged;
        base.OnInitialized();
    }

    public void Dispose()
    {
        Navigation.OnStateChanged -= StateHasChanged;
    }
}
