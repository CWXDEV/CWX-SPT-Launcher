@using NavigationManager = Spt.Backend.NavigationManager
@inject NavigationManager NavigationManager

<MudNavMenu>
    <MudNavLink IconColor="Color.Default" Icon="@Icons.Material.Filled.ConnectedTv" Match="NavLinkMatch.All" Href="/">Servers</MudNavLink>
    @if (NavigationManager.ShowProfilesPage)
    {
        <MudNavLink IconColor="Color.Default" Icon="@Icons.Material.Filled.PeopleAlt" Match="NavLinkMatch.All" Href="/Profiles">Profiles</MudNavLink>
    }
    @if (NavigationManager.ShowProfilePage)
    {
        <MudNavLink IconColor="Color.Default" Icon="@Icons.Material.Filled.Person" Match="NavLinkMatch.All" Href="/Profile">Profile</MudNavLink>
    }
    @if (NavigationManager.ShowModPage)
    {
        <MudNavLink IconColor="Color.Default" Icon="@Icons.Material.Filled.FolderOpen" Match="NavLinkMatch.All" Href="/ActiveMods">Mods</MudNavLink>
    }
</MudNavMenu>
<MudSpacer/>
<MudNavMenu>
    @if (NavigationManager.ShowLoggingPage)
    {
        <MudNavLink IconColor="Color.Default" Icon="@Icons.Material.Filled.AdminPanelSettings" Match="NavLinkMatch.All" Href="/Admin">Admin</MudNavLink>
    }
    <MudNavLink IconColor="Color.Default" Icon="@Icons.Material.Filled.FolderZip" Match="NavLinkMatch.All" Href="/ModManager">Mod Manager</MudNavLink>
    <MudNavLink IconColor="Color.Default" Icon="@Icons.Material.Filled.Settings" Match="NavLinkMatch.All" Href="/Settings">Settings</MudNavLink>
    <MudNavLink IconColor="Color.Default" Icon="@Icons.Material.Filled.Info" Match="NavLinkMatch.All" Href="/Info">Info</MudNavLink>
</MudNavMenu>

@code
{
    protected override void OnInitialized()
    {
        NavigationManager.OnStateChanged += StateHasChanged;
        base.OnInitialized();
    }

    public void Dispose()
    {
        NavigationManager.OnStateChanged -= StateHasChanged;
    }
}
