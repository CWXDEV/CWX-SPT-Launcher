@inject ConfigHelper _configHelper

<MudItem sm="12">
    <MudPaper Class="pa-5 ml-1 gap-2 d-flex flex-column card-overflow" Elevation="3">
        <SettingOptionComponent Switch="@advancedUserSwitch" OptionName="Advanced User" SwitchFunc="@SetAdvUser"/>
    </MudPaper>
</MudItem>

@code
{
    private bool advancedUserSwitch { get; set; }

    protected override void OnInitialized()
    {
        advancedUserSwitch = _configHelper.GetConfig().AppSettings.AdvancedUser;
        base.OnInitialized();
    }

    private async Task SetAdvUser()
    {
        advancedUserSwitch = !advancedUserSwitch;
        _configHelper.SetAdvancedUser(advancedUserSwitch);
    }
}
