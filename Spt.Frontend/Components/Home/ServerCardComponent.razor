@using NavigationManager = Spt.Backend.NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject Microsoft.AspNetCore.Components.NavigationManager NavMan
@inject StateManager StateManager
@inject ConfigManager Config
@inject NavigationManager NavigationManager

<MudItem md="4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Class="mb-n4 no-pointers no-select" Typo="Typo.caption">Name:</MudText>
                <MudText Typo="Typo.body1">@Server.Name</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudTooltip Text="Edit server" Arrow="true" Placement="Placement.Bottom">
                <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Default" @onclick="RunEditTask"/>
                </MudTooltip>
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent Class="py-2">
            <MudText Class="mb-n3 no-pointers no-select" Typo="Typo.caption">Address:</MudText>
            <MudText Typo="Typo.body1">@Server.Ip</MudText>
        </MudCardContent>
        <MudCardActions Class="pa-4 d-flex mt-2">
            <MudTooltip Text="@(IsConnectedServer ? "Connected" : "Disconnected")" Arrow="true" Placement="Placement.Bottom">
                <MudIcon Class="mb-n2" Icon="@Icons.Material.Filled.Circle" Color="@(IsConnectedServer ? Color.Success : Color.Error)"/>
            </MudTooltip>
            <MudSpacer/>
            <MudTooltip Text="@(!IsConnectedServer ? "Login to server" : "Logout of server")" Arrow="true" Placement="Placement.Bottom">
                <MudIconButton Class="mr-1" Color="Color.Default"
                               Icon="@(!IsConnectedServer ? Icons.Material.Filled.Login : Icons.Material.Filled.Logout)"
                               Size="Size.Small" @onclick="RunLoginTask"/>
            </MudTooltip>
            <MudTooltip Text="Delete server" Arrow="true" Placement="Placement.Bottom">
                <MudIconButton Color="Color.Error" Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                               @onclick="RunDeleteTask"/>
            </MudTooltip>
        </MudCardActions>
    </MudCard>
