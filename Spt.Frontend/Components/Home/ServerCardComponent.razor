</MudItem>

@code {
    [Parameter] public Servers Server { get; set; }

    [Parameter] public List<Servers> ServerList { get; set; }

    [Parameter] public EventCallback<List<Servers>> ServerListChanged { get; set; }

    private bool IsConnectedServer { get; set; }

    protected override void OnInitialized()
    {
        IsConnectedServer = StateManager.ConnectedServer?.ServerId == Server.ServerId;
        base.OnInitialized();
    }

    private async Task RunEditTask()
    {
        if (StateManager.ConnectedServer?.ServerId == Server.ServerId)
        {
            StateManager.LogoutAndDispose();
            IsConnectedServer = false;
        }

        var param = new DialogParameters { { "Server", Server } };

        var dialog = await DialogService.ShowAsync<ServerEditDialog>("ServerEditDialog", param, Config.DialogOptions);
        var result = await dialog.Result;

        if (result?.Canceled is false)
        {
            var serverToChange = ServerList.FirstOrDefault(x => x.ServerId == Server.ServerId);

            if (serverToChange != null)
            {
                serverToChange.Name = Server.Name;
                serverToChange.Ip = Server.Ip;
            }

            Config.SetServers(ServerList);
            await ServerListChanged.InvokeAsync(ServerList);
        }
    }

    private async Task RunLoginTask()
    {
        if (StateManager.ConnectedServer != null)
        {
            if (StateManager.ConnectedServer.ServerId == Server.ServerId)
            {
                StateManager.LogoutAndDispose();
                NavigationManager.SetBasicPages(false);
                NavigationManager.SetProfilePages(false);
                IsConnectedServer = false;
                return;
            }

            StateManager.LogoutAndDispose();
            NavigationManager.SetBasicPages(false);
            NavigationManager.SetProfilePages(false);
            IsConnectedServer = false;
        }

        var param = new DialogParameters { { "Server", Server } };

        var dialog = await DialogService.ShowAsync<ServerLoginDialog>("ServerLoginDialog", param, Config.DialogOptions);
        var result = await dialog.Result;

        if (result?.Canceled is false)
        {
            StateManager.ServerLogin(Server);
            if (StateManager.ConnectedServer != null)
            {
                IsConnectedServer = StateManager.ConnectedServer.ServerId == Server.ServerId;
            }

            NavMan.NavigateTo("/Profiles");
        }
    }

    private async Task RunDeleteTask()
    {
        if (StateManager.ConnectedServer != null)
        {
            StateManager.LogoutAndDispose();
            IsConnectedServer = false;
        }

        var dialog = await DialogService.ShowAsync<ServerRemoveDialog>("ServerRemoveDialog", Config.DialogOptions);
        var result = await dialog.Result;

        if (result?.Canceled is false)
        {
            ServerList.Remove(Server);
            await ServerListChanged.InvokeAsync(ServerList);

            Config.SetServers(ServerList);
        }
    }

}
