@inject ConfigManager Config

<MudItem sm="12">
    <MudPaper Class="pa-5 ml-1 gap-2 d-flex flex-column card-overflow" Elevation="3">
        <SettingOptionComponent Switch="@debugUserSwitch" OptionName="Debug Options" SwitchFunc="@SetDebugUser"/>
    </MudPaper>
</MudItem>

@code
{
    private bool debugUserSwitch { get; set; }

    protected override void OnInitialized()
    {
        var settings = Config.GetConfig();
        debugUserSwitch = settings.DebugSettings.DebugUser;

        base.OnInitialized();
    }

    private void SetDebugUser()
    {
        debugUserSwitch = !debugUserSwitch;
        Config.SetDebugUser(debugUserSwitch);

        // clean up later
        if (!debugUserSwitch)
        {
            // set all debug options to false
        }
    }
}
