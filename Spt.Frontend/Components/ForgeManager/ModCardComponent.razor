@inject ISnackbar _snackbar
@inject IDialogService _dialogService
@inject ForgeHelper _forgeHelper
@inject HttpHelper _httpHelper
@inject ConfigHelper _configHelper
@inject LogHelper _logHelper
@inject NavigationManager _navman

<MudItem sm="6">
    @if (IsSkeleton)
    {
        <MudCard Class="info-card-height mud-background-gray border-2 border-solid mud-border-lines-default">
            <MudCardHeader>
                <CardHeaderAvatar>
                    @* Randomise colour *@
                    <MudSkeleton SkeletonType="SkeletonType.Circle" Height="40px" Width="40px"/>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudSkeleton Width="40%"/>
                    <MudSkeleton Width="60%"/>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudSkeleton SkeletonType="SkeletonType.Circle" Height="30px" Width="30px" Class="ml-2 mb-2"/>
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="150px" />
            </MudCardContent>
            <MudCardActions>
                <MudSkeleton SkeletonType="SkeletonType.Circle" Height="30px" Width="30px" Class="ml-2 mb-2"/>
                <MudSkeleton SkeletonType="SkeletonType.Circle" Height="30px" Width="30px" Class="ml-3 mb-2"/>
            </MudCardActions>
        </MudCard>
    }
    else
    {
        <MudCard Class="info-card-height mud-background-gray border-2 border-solid mud-border-lines-default">
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Secondary">@GetAvatarLetter()</MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.body1">@GetModName()</MudText>
                    <MudText Typo="Typo.body2">By @GetModdersName()</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    @if (GetModFeatured())
                    {
                        <MudTooltip Arrow="true" Placement="Placement.Bottom" Text="Featured">
                            <MudIconButton Icon="@Icons.Material.Filled.Favorite" Color="Color.Primary"/>
                        </MudTooltip>
                    }
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.body2">@GetModTeaser()</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudIconButton Icon="@Icons.Material.Filled.Download" Color="Color.Default"/>
                <MudIconButton Icon="@Icons.Material.Filled.Share" Color="Color.Default" @onclick="(() => NavigateToSingleMod(ForgeMod.Id))"/>
            </MudCardActions>
        </MudCard>
    }
</MudItem>

@code {
    [Parameter] public bool IsSkeleton { get; set; }

    [Parameter] public ForgeBase ForgeMod { get; set; }

    private char? GetAvatarLetter()
    {
        return ForgeMod.Owner.Name.ToUpper()[0];
    }

    private string? GetModName()
    {
        return ForgeMod.Name.UppercaseFirst();
    }

    private string? GetModdersName()
    {
        return ForgeMod.Owner.Name.UppercaseFirst();
    }

    private string? GetModTeaser()
    {
        return ForgeMod.Teaser.UppercaseFirst();
    }

    private bool GetModFeatured()
    {
        return ForgeMod.Featured ?? false;
    }

    private void NavigateToSingleMod(int? modId)
    {
        // navigate to mod page
        Console.WriteLine($"Navigating to mod page: {modId}");
        _navman.NavigateTo($"/ForgeModPage/{modId}");
    }
}
