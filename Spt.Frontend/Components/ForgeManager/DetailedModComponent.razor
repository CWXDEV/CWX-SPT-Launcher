@inject ISnackbar _snackbar
@inject IDialogService _dialogService
@inject ForgeHelper _forgeHelper
@inject HttpHelper _httpHelper
@inject ConfigHelper _configHelper
@inject LogHelper _logHelper
@inject NavigationManager _navman

<MudItem sm="12">
    @if (IsSkeleton)
    {
        // Create replica of Below layout as a skeleton
        <MudGrid>
            <MudItem sm="8">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="200px" Class="mb-4"/>
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="100px" Class="mb-4"/>
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="300px"/>
            </MudItem>
            <MudItem sm="4">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="300px" Class="mb-4"/>
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="100px"/>
            </MudItem>
        </MudGrid>
    }
    else
    {
        <MudGrid>
            <MudItem sm="8">
                <MudCard Class="mud-background-gray border-2 border-solid mud-border-lines-default mb-4">
                    <MudCardHeader>
                        <MudGrid>
                            <MudItem sm="2">
                                <MudImage Src="@($"https://forge-static.sp-tarkov.com/{@ForgeMod.Thumbnail}")"/>
                            </MudItem>
                            <MudItem sm="10">
                                <MudLink Href="@($"https://forge.sp-tarkov.com/mod/{ForgeMod.Id}/{ForgeMod.Slug}")" Typo="Typo.h6">@ForgeMod.Name</MudLink>
                                <MudText Typo="Typo.body1" Class="no-pointers no-select">By @ForgeMod.Owner.Name</MudText>
                                <MudText Typo="Typo.body2" Class="no-pointers no-select">@ForgeMod.Downloads Downloads</MudText>
                            </MudItem>
                        </MudGrid>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText>@ForgeMod.Teaser</MudText>
                    </MudCardContent>
                </MudCard>
                @if (ForgeVersions is null)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="100px" Class="mb-4"/>
                }
                else
                {
                    <MudCard Class="mud-background-gray border-2 border-solid mud-border-lines-default mb-4">
                        <MudCardHeader>
                            <MudGrid>
                                <MudItem sm="8">
                                    <MudText Typo="Typo.h6" Class="no-pointers no-select">Version @ForgeVersions.FirstOrDefault().Version</MudText>
                                    <MudLink Href="@ForgeVersions.FirstOrDefault().VirusTotalLink">Virus Total Results</MudLink>
                                </MudItem>
                                <MudItem sm="4" Class="d-flex flex-column align-end">
                                    @* need to convert to readable date/time *@
                                    <MudText Typo="Typo.body1" Class="no-pointers no-select">Created 6th April</MudText> @* @ForgeVersions.FirstOrDefault().CreatedAt *@
                                    <MudText Typo="Typo.body1" Class="no-pointers no-select">Published 6th April</MudText> @* @ForgeVersions.FirstOrDefault().PublishedAt *@
                                </MudItem>
                            </MudGrid>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudText Class="markdown">
                                @((MarkupString) Markdown.ToHtml(@ForgeVersions.FirstOrDefault().Description))
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                }
                <MudCard Class="mud-background-gray border-2 border-solid mud-border-lines-default">
                    <MudCardContent>
                        <MudText Class="markdown">
                            @((MarkupString) Markdown.ToHtml(@ForgeMod.Description))
                        </MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem sm="4">
                <MudItem sm="12"><MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download" Label="@($"Download Latest ({@ForgeMod.Versions.FirstOrDefault().Version})")" Class="mb-4" Style="width: 100%"/></MudItem>
                <MudCard Class="mud-background-gray border-2 border-solid mud-border-lines-default">
                    <MudCardContent Class="d-flex flex-column align-start text-overflow">
                        <MudItem Class="pb-4">
                            <MudText Typo="Typo.h6" Class="no-pointers no-select">Details</MudText>
                        </MudItem>
                        <MudText Typo="Typo.body1" Class="no-pointers no-select">Additional Authors</MudText>
                        <MudText Typo="Typo.caption" Class="pb-2">@(ForgeMod.Authors.Any() ? ForgeMod.Authors.Select(x => x.Name).Aggregate((i, j) => i + ", " + j) : "None")</MudText>
                        <MudText Typo="Typo.body1" Class="no-pointers no-select">License</MudText>
                        <MudText Typo="Typo.caption" Class="pb-2">License to add</MudText>
                        <MudText Typo="Typo.body1" Class="no-pointers no-select">Source Code</MudText>
                        <MudText Typo="Typo.caption" Class="pb-2">
                            @if (ForgeMod.SourceCodeLink is not null)
                            {
                                <MudLink Typo="Typo.caption" Href="@ForgeMod.SourceCodeLink">@ForgeMod.SourceCodeLink</MudLink>
                            }
                            else
                            {
                                @("None")
                            }
                        </MudText>
                        <MudText Typo="Typo.body1" Class="no-pointers no-select">Latest Version VirusTotal Result</MudText>
                        <MudText Typo="Typo.caption" Class="pb-2">
                            @if (ForgeMod.Versions.FirstOrDefault().VirusTotalLink is not null)
                            {
                                <MudLink Typo="Typo.caption" Href="@ForgeMod.Versions.FirstOrDefault().VirusTotalLink">@ForgeMod.Versions.FirstOrDefault().VirusTotalLink</MudLink>
                            }
                            else
                            {
                                @("None")
                            }
                        </MudText>
                    </MudCardContent>
                </MudCard>
                @if (ForgeVersions is null)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="100px" Class="mb-4"/>
                }
                else
                {
                    <MudCard Class="mud-background-gray border-2 border-solid mud-border-lines-default">
                        @* other versions component *@
                    </MudCard>
                }
            </MudItem>
        </MudGrid>
    }
</MudItem>

@code {
    [Parameter] public bool IsSkeleton { get; set; }
    [Parameter] public ForgeBase ForgeMod { get; set; }
    [Parameter] public List<ForgeModVersion> ForgeVersions { get; set; }
}
