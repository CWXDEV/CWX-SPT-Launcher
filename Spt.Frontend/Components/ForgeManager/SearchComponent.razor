@inject IJSRuntime _jsRuntime

<MudContainer Class="d-flex flex-column px-0 mb-4">
    <MudGrid>
        <MudItem sm="6">
            <MudTextField @bind-Value="Search" Label="Search" Variant="Variant.Outlined" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" AdornmentColor="Color.Primary" Clearable="true" DebounceInterval="500" OnDebounceIntervalElapsed="SearchFunc" />
        </MudItem>
        <MudItem sm="3">
            <MudSelect @bind-Value="SortValue" Label="Sort" Variant="Variant.Outlined" Dense="true" AdornmentIcon="@Icons.Material.Filled.Sort" AdornmentColor="Color.Primary">
                <MudSelectItem Value="@("Newest")">Newest</MudSelectItem>
                <MudSelectItem Value="@("Recently Updated")">Recently Updated</MudSelectItem>
                <MudSelectItem Value="@("Most Downloaded")">Most Downloaded</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem sm="3">
            <MudSelect @bind-Value="FilterValue" Label="Featured" Variant="Variant.Outlined" Dense="true" AdornmentIcon="@Icons.Material.Filled.FilterAlt" AdornmentColor="Color.Primary">
                <MudSelectItem Value="@("Include")">Include</MudSelectItem>
                <MudSelectItem Value="@("Exclude")">Exclude</MudSelectItem>
                <MudSelectItem Value="@("Only")">Only</MudSelectItem>
            </MudSelect>
        </MudItem>
    </MudGrid>

    <MudFab id="scrollTopBtn" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowCircleUp" Class="fixed z-90" Style="bottom: 10px; right: 10px; display: none;" @onclick="ScrollToTop" Size="Size.Small"/>

</MudContainer>

@code {
    private string search = "";
    [Parameter]
    public string Search
    {
        get => search;
        set
        {
            if (search == value)
            {
                return;
            }

            search = value;
            SearchChanged.InvokeAsync(search);
        }
    }
    [Parameter] public EventCallback<string> SearchChanged { get; set; }

    private string sortValue = "Newest";
    [Parameter]
    public string SortValue
    {
        get => sortValue;
        set
        {
            if (sortValue == value)
            {
                return;
            }

            sortValue = value;
            SortValueChanged.InvokeAsync(sortValue);
        }
    }
    [Parameter] public EventCallback<string> SortValueChanged { get; set; }

    private string filterValue = "Include";
    [Parameter]
    public string FilterValue
    {
        get => filterValue;
        set
        {
            if (filterValue == value)
            {
                return;
            }

            filterValue = value;
            FilterValueChanged.InvokeAsync(filterValue);
        }
    }
    [Parameter] public EventCallback<string> FilterValueChanged { get; set; }
    [Parameter] public Func<Task> SearchFunc { get; set; }

    private async Task ScrollToTop()
    {
        await _jsRuntime.InvokeVoidAsync("scrollToTopSmooth");
    }
}
